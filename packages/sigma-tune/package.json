{
  "name": "@noisebound/sigma-tune",
  "version": "0.0.0",
  "private": true,
  "description": "LoRA/QLoRA fine-tuning dataset generator for σ-1's base model (Qwen3-30B-A3B), grounded in the real session-key / scoped-send / escalation primitives from sigma-core, sigma-execute, and pqc-wallet. Dev/research tool only — never imported by apps/app or other packages.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "generate": "tsc -p tsconfig.json && node dist/cli.js"
  },
  "dependencies": {
    "@noisebound/pqc-wallet": "workspace:*",
    "@noisebound/sigma-core": "workspace:*",
    "@noisebound/sigma-execute": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
